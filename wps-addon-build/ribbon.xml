<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="OnAddinLoad">
    <ribbon startFromScratch="false">
        <tabs>
            <tab id="wpsAddinTab" label="MyTools" insertAfterMso="TabHome">
                <group id="G1" label="窗口工具">
                    <button id="btn万能计算" getLabel="OnGetLabel" onAction="OnAction"
                        getEnabled="OnGetEnabled" getImage="GetImage" getVisible="OnGetVisible"
                        getSupertip="OnGetSupertip" size="large" />
                    <button id="btn随机填充" getLabel="OnGetLabel" onAction="OnAction"
                        getEnabled="OnGetEnabled" getImage="GetImage" getVisible="OnGetVisible"
                        getSupertip="OnGetSupertip" size="large" />
                    <button id="btnECharts绘图" getLabel="OnGetLabel" onAction="OnAction"
                        getEnabled="OnGetEnabled" getImage="GetImage" getVisible="OnGetVisible"
                        getSupertip="OnGetSupertip" size="large" />
                    <separator id="sep1" visible="true" />
                </group>
                <group id="G2" label="数值变换">
                    <button id="btn区域复制到所有表" getLabel="OnGetLabel" onAction="OnAction"
                        getEnabled="OnGetEnabled" getImage="GetImage" getVisible="OnGetVisible"
                        getSupertip="OnGetSupertip" size="small" />
                    <button id="btn人民币大写金额" getLabel="OnGetLabel" onAction="OnAction"
                        getEnabled="OnGetEnabled" getImage="GetImage" getVisible="OnGetVisible"
                        getSupertip="OnGetSupertip" size="small" />
                    <button id="btn乘以1万" getLabel="OnGetLabel" onAction="OnAction"
                        getEnabled="OnGetEnabled" getImage="GetImage" getVisible="OnGetVisible"
                        getSupertip="OnGetSupertip" size="small" />
                    <button id="btn除以1万" getLabel="OnGetLabel" onAction="OnAction"
                        getEnabled="OnGetEnabled" getImage="GetImage" getVisible="OnGetVisible"
                        getSupertip="OnGetSupertip" size="small" />
                    <separator id="sep1" visible="true" />
                </group>
                <group id="G3" label="表格处理">
                    <button id="btn按选定列去重" getLabel="OnGetLabel" onAction="OnAction"
                        getEnabled="OnGetEnabled" getImage="GetImage" getVisible="OnGetVisible"
                        getSupertip="OnGetSupertip" size="small" />
                    <button id="btn删除空格" getLabel="OnGetLabel" onAction="OnAction"
                        getEnabled="OnGetEnabled" getImage="GetImage" getVisible="OnGetVisible"
                        getSupertip="OnGetSupertip" size="small" />
                    <button id="btn仅保留可见" getLabel="OnGetLabel" onAction="OnAction"
                        getEnabled="OnGetEnabled" getImage="GetImage" getVisible="OnGetVisible"
                        getSupertip="OnGetSupertip" size="small" />
                    <button id="btn数据合并" getLabel="OnGetLabel" onAction="OnAction"
                        getEnabled="OnGetEnabled" getImage="GetImage" getVisible="OnGetVisible"
                        getSupertip="OnGetSupertip" size="small" />
                    <separator id="sep1" visible="true" />
                </group>
                <group id="G4" label="表格拆分">
                    <button id="btn拆分为工作表" getLabel="OnGetLabel" onAction="OnAction"
                        getEnabled="OnGetEnabled" getImage="GetImage" getVisible="OnGetVisible"
                        getSupertip="OnGetSupertip" size="small" />
                    <button id="btn拆分为工作簿" getLabel="OnGetLabel" onAction="OnAction"
                        getEnabled="OnGetEnabled" getImage="GetImage" getVisible="OnGetVisible"
                        getSupertip="OnGetSupertip" size="small" />
                    <button id="btn每表一簿" getLabel="OnGetLabel" onAction="OnAction"
                        getEnabled="OnGetEnabled" getImage="GetImage" getVisible="OnGetVisible"
                        getSupertip="OnGetSupertip" size="small" />
                    <separator id="sep1" visible="true" />
                </group>
                <group id="G5" label="网络数据">
                    <button id="btn查询LPR" getLabel="OnGetLabel" onAction="OnAction"
                        getEnabled="OnGetEnabled" getImage="GetImage" getVisible="OnGetVisible"
                        getSupertip="OnGetSupertip" size="large" />
                    <button id="btn发票识别" getLabel="OnGetLabel" onAction="OnAction"
                        getEnabled="OnGetEnabled" getImage="GetImage" getVisible="OnGetVisible"
                        getSupertip="OnGetSupertip" size="large" />
                    <separator id="sep1" visible="true" />
                </group>
                <group id="G6" label="规划求解">
                    <button id="btn规划求解" getLabel="OnGetLabel" onAction="OnAction"
                        getEnabled="OnGetEnabled" getImage="GetImage" getVisible="OnGetVisible"
                        getSupertip="OnGetSupertip" size="large" />
                    <separator id="sep1" visible="true" />
                </group>
            </tab>
        </tabs>
    </ribbon>
</customUI>